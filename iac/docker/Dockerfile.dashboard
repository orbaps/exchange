# Dockerfile for Dashboard (Frontend)
# Multi-stage build: node builder -> nginx runtime
# Serves React SPA with nginx

# =============================================================================
# STAGE 1: Builder (Node.js)
# =============================================================================
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --prefer-offline --no-audit --progress=false

# Copy source code
COPY frontend/ ./

# Build production bundle
RUN npm run build

# =============================================================================
# STAGE 2: Runtime (nginx)
# =============================================================================
FROM nginx:alpine AS runtime

# Create non-root user
RUN addgroup -g 10001 -S appuser && \
    adduser -u 10001 -S -G appuser -h /var/cache/nginx appuser

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY iac/docker/nginx.dashboard.conf /etc/nginx/conf.d/default.conf

# Create required directories and set permissions
RUN mkdir -p /var/cache/nginx/client_temp \
    /var/cache/nginx/proxy_temp \
    /var/cache/nginx/fastcgi_temp \
    /var/cache/nginx/uwsgi_temp \
    /var/cache/nginx/scgi_temp \
    /var/run/nginx \
    && chown -R appuser:appuser /var/cache/nginx /var/run/nginx /usr/share/nginx/html \
    && chmod -R 755 /usr/share/nginx/html

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Expose port
EXPOSE 8080

# Environment variables
ENV NGINX_PORT=8080

# Entrypoint
ENTRYPOINT ["nginx", "-g", "daemon off;"]